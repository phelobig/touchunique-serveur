# Touch Unique Studio — modèle de configuration serveur (aucune valeur réelle)
# Copier les lignes utiles dans l'environnement du serveur OU dans un fichier privé local.
# Ce fichier peut être versionné : il ne contient que des noms et des exemples vides.

# --- Fichier privé local (chargé au démarrage, silencieusement) -------------
# 1) TUS_PRIVATE_ENV peut désigner explicitement un fichier CLE=valeur.
# 2) Sinon : %APPDATA%\touch-unique-studio\private-env.txt
#    (C:\Users\NITRO\AppData\Roaming\touch-unique-studio\private-env.txt)
# 3) Sinon : server/private-env.txt (non versionné).
# Les valeurs du fichier complètent os.environ sans jamais écraser une variable
# déjà définie. Aucune valeur n'est journalisée ni renvoyée par l'API.
TUS_PRIVATE_ENV=
# TUS_PRIVATE_ENV=C:\Users\NITRO\AppData\Roaming\touch-unique-studio\private-env.txt

# --- Serveur et origines ---------------------------------------------------
ALLOWED_ORIGIN=https://phelobig.github.io
ALLOWED_ORIGINS=https://phelobig.github.io,https://phelobig.github.io/touchunique-site,https://phelobig.github.io/touchunique-app,app://-
TUS_PROXY_TOKEN=remplacez-par-une-longue-chaine-aleatoire
TUS_VAULT_KEY=remplacez-par-une-autre-chaine-aleatoire-longue
PUBLIC_BASE_URL=https://VOTRE-SERVEUR.onrender.com

# --- Langues / IA ----------------------------------------------------------
# Langue utilisée quand le client n'envoie pas `lang` et que rien n'est détecté.
# L'API /api/ai accepte {"lang": "fr"|"en"} et renvoie toujours `lang`.
# /api/status expose langues: ['fr','en'] et la version 7.
TUS_DEFAULT_LANG=fr
# Limite technique ONLY, jamais un quota : 120 requêtes/min/IP au minimum.
AI_RATE_LIMIT_PER_MIN=120

# Fournisseur Web public sans clé, prioritaire et illimité : pas de secret requis.
# Modèles/openai compatibles : laissez vide pour utiliser api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
POLLINATIONS_MODEL=openai

# --- Google Drive OAuth ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://VOTRE-SERVEUR.onrender.com/api/google/callback

# --- Réseaux sociaux -------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_PERSON_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_USER_ID=

# --- Robots et écoute ------------------------------------------------------
TUS_ROBOT_AUTORUN=0
TUS_ROBOT_HOUR=0
TUS_ROBOT_PUBLISH=0
HOST=0.0.0.0
PORT=8000
