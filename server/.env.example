# Copier dans les variables d'environnement du serveur (jamais dans le navigateur)

ALLOWED_ORIGIN=https://phelobig.github.io
ALLOWED_ORIGINS=https://phelobig.github.io,https://phelobig.github.io/touchunique-site,https://phelobig.github.io/touchunique-app,app://-,file://
TUS_PROXY_TOKEN=remplacez-par-une-longue-chaine-aleatoire
TUS_VAULT_KEY=remplacez-par-une-autre-chaine-aleatoire-longue

# Fournisseurs IA (vous pourrez aussi les saisir dans les réglages de l'application)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Réseaux sociaux
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# Google Drive OAuth (Client ID / Secret créés dans Google Cloud, URI de redirection ci-dessous)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://VOTRE-SERVEUR.onrender.com/api/google/callback

# Robots quotidiens
TUS_ROBOT_AUTORUN=1
TUS_ROBOT_HOUR=0

HOST=0.0.0.0
PORT=8000
